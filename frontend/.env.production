REACT_APP_BACKEND_URL=https://cinesync-nosy.onrender.com

# Optional TURN relay for viewers/hosts behind symmetric NAT (mobile data,
# corporate networks). Without this, only STUN is used — works on most home
# networks but not all. Uncomment and fill in with a real TURN provider
# (e.g. Twilio, Cloudflare Calls, or a self-hosted coturn) to enable it.
# REACT_APP_TURN_URL=turn:your-turn-host:3478
# REACT_APP_TURN_USERNAME=
# REACT_APP_TURN_CREDENTIAL=
